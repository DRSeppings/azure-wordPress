
# Terraform state files
*.tfstate
*.tfstate.*
*.backup

# Terraform plan files
tfplan
*.tfplan

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Local .terraform directories and provider binaries
**/.terraform/*
.terraform/

# Lock file — commit this to pin provider versions
# .terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

# OS junk
*.info
*.exe
.DS_Store
Thumbs.db
